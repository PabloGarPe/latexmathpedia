# Copia este fichero a .env.local y rellena los valores.

# --- Backend ---
# Base URL del backend de Mathtexpedia.
# En desarrollo, si se omite, lib/env.ts usa http://localhost:8081 por defecto.
# En producción es obligatoria (si falta, se avisa por consola y se cae al default de dev).
NEXT_PUBLIC_API_URL=http://localhost:8081

# --- Modo de autenticación ---
# "mock" (por defecto si se omite): auth 100% local, sin backend ni Keycloak. Expone tres
# identidades de prueba (admin/usuario/anónimo) alternables desde el menú de usuario de la
# sidebar. Úsalo mientras Keycloak no esté disponible o no haga falta probarlo de verdad.
# "keycloak": auth real vía Auth.js + Keycloak (ver auth.ts). Requiere además las variables
# AUTH_*/KEYCLOAK_* de más abajo.
NEXT_PUBLIC_AUTH_MODE=mock

# --- Auth.js (solo si NEXT_PUBLIC_AUTH_MODE=keycloak) ---
# Secreto para cifrar la cookie de sesión. Genéralo con: npx auth secret
AUTH_SECRET=
# URL pública de este frontend (se usa para construir las URLs de callback)
AUTH_URL=http://localhost:3000

# --- Keycloak (solo si NEXT_PUBLIC_AUTH_MODE=keycloak) ---
# URL base del servidor Keycloak (sin /realms/...)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mathtexpedia
# Cliente con "Standard flow" activado.
# Valid redirect URI:              {AUTH_URL}/api/auth/callback/keycloak
# Valid post logout redirect URI:  {AUTH_URL}/*
KEYCLOAK_CLIENT_ID=mathtexpedia-api
# Déjalo vacío si el cliente es público (publicClient: true); se usará PKCE
KEYCLOAK_CLIENT_SECRET=
# Rol (de realm o del cliente) que da acceso al panel de administración
KEYCLOAK_ADMIN_ROLE=ADMIN
